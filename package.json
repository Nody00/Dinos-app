{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "dev": "pnpm run docker:up && pnpm run start:dev",
    "dev:setup": "pnpm prisma db seed && pnpm run dev",
    "dev:debug": "pnpm run docker:up && pnpm run start:debug",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:unit": "vitest run --config test/vitest-unit.config.ts",
    "test:integration": "vitest run --config test/vitest-integration.config.ts",
    "test:e2e": "vitest run --config test/vitest-e2e.config.ts",
    "test:all": "vitest run",
    "test:watch": "vitest watch",
    "test:watch:unit": "vitest watch --config test/vitest-unit.config.ts",
    "test:cov": "vitest run --coverage",
    "test:cov:unit": "vitest run --config test/vitest-unit.config.ts --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/microservices": "^11.1.11",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@sendgrid/mail": "^8.1.6",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "jwks-rsa": "^3.2.0",
    "keycloak-connect": "^26.1.1",
    "nest-keycloak-connect": "^1.10.1",
    "nodemailer": "^7.0.12",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
